# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values before running docker compose
# ---------------------------------------------------------------------------

# Production domain (used by Caddy for automatic HTTPS via Let's Encrypt).
# Point your domain's DNS A record at the server's public IP before starting
# Caddy, or cert issuance will fail. Leave as localhost for local dev.
DOMAIN=localhost

# Postgres
POSTGRES_USER=waplatform
POSTGRES_PASSWORD=change_me
POSTGRES_DB=waplatform
DATABASE_URL=postgresql://waplatform:change_me@localhost:5432/waplatform?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend
PORT=3001
NODE_ENV=development
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
# In production, set to your public domain, e.g. https://yourapp.duckdns.org
CORS_ORIGIN=http://localhost:3000
SECRETS_ENCRYPTION_KEY=change_me_to_a_random_32plus_char_secret

# WhatsApp Business Platform (Meta Cloud API)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change_me_webhook_verify_token
# App Secret from the Meta App Dashboard -> Settings -> Basic. Required to
# verify the X-Hub-Signature-256 header on every inbound webhook POST; the
# server refuses all webhook POSTs if this is unset (fail closed).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=waplatform-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Frontend
# Leave this BLANK (recommended) for local Docker use, tunneling (Cloudflare
# Tunnel/ngrok), or any setup where the public URL might change — the app
# now defaults to relative/same-origin API calls, proxied server-side to
# the backend container by a Next.js rewrite, so it works no matter what
# hostname the browser is actually using to reach it.
# Only set this if the backend is genuinely on a DIFFERENT origin than the
# frontend (e.g. split hosting) — in that case set the real public backend
# URL and rebuild (docker compose build frontend) since this is baked in
# at build time.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# AI features (message generation/rewrite/translate). Any OpenAI-compatible
# chat completions endpoint works. Left empty, AI endpoints return a clear
# "not configured" error instead of fabricating a response.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email/Slack/Telegram notification channels are configured per-organization
# in the app (Settings > Notification Channels), not here — SMTP passwords
# and Telegram bot tokens are encrypted at rest the same way as the WhatsApp
# access token.

# System-wide SMTP account used ONLY for auth transactional emails (password
# reset, email verification) — separate from the per-org channels above
# because these have to work before an org has configured anything. If left
# unset, reset/verification links are logged to the backend console instead
# of emailed, so auth flows still work in local dev without real SMTP creds.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM=no-reply@yourdomain.com
