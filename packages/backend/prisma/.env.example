# Copy this file to prisma/.env (gitignored, never committed) before
# running `npm run test:e2e` or `npx prisma migrate deploy` locally.
#
# Read automatically by the Prisma CLI (generate/migrate/studio) — this
# file, if present, takes precedence over the root .env for Prisma commands
# specifically, per
# https://www.prisma.io/docs/orm/more/development-environment/environment-variables/env-files
#
# It is NOT read by the running NestJS app (ConfigModule only loads the
# regular .env in packages/backend), so this has zero effect on
# `npm run start:dev` or production — it only affects `prisma generate`,
# `prisma migrate *`, and `prisma studio`.
#
# The values below match the project's existing docker-compose Postgres
# (see docker-compose.yml — host port 5433, default user/password
# "waplatform"), pointed at a dedicated `waplatform_test` database so
# `prisma migrate deploy` for e2e tests never touches real local dev data.
# That database must exist before running e2e tests:
#   docker compose up -d postgres
#   docker compose exec postgres createdb -U waplatform waplatform_test
#
# If your local Postgres uses different credentials or a different port
# (e.g. a native install instead of docker-compose), change these to match
# — this is a local file, not shared or committed.
DATABASE_URL="postgresql://waplatform:waplatform@127.0.0.1:5433/waplatform_test?schema=public"
DIRECT_DATABASE_URL="postgresql://waplatform:waplatform@127.0.0.1:5433/waplatform_test?schema=public"
