// ---------------------------------------------------------------------------
// Prisma schema — WhatsApp Business Automation Platform
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Only matters for Supabase (or any pooled/pgbouncer connection) — Prisma
  // migrations use prepared statements, which pgbouncer's transaction-mode
  // pooling doesn't support. DIRECT_DATABASE_URL should point at Supabase's
  // direct (non-pooled) connection string for `prisma migrate`, while
  // DATABASE_URL stays on the pooled connection for normal app queries. For
  // local Docker Postgres (no pooler involved at all), just set both env
  // vars to the same value — see docker-compose.yml.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organizations & Users
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  timezone  String   @default("UTC")
  language  String   @default("en")
  theme     Theme    @default(AUTO)
  // Platform-level (Super Admin) status — independent of anything an
  // organization's own members can set themselves. SUSPENDED blocks login
  // for that org's users (see AuthService) without touching any of their
  // data. Defaulting to ACTIVE preserves every existing organization's
  // current (working) behavior with no backfill needed.
  status    OrganizationStatus @default(ACTIVE)
  suspendedAt DateTime?
  suspendedReason String?
  // Nullable and NOT auto-assigned to existing or new organizations by this
  // migration — see Plan model's doc comment for why. An org with no plan
  // and no OrganizationQuotaOverride is unlimited on every resource, which
  // is what every organization already effectively has today; assigning
  // limits is something a Super Admin opts an org into going forward, not
  // something this migration silently imposes on anyone.
  planId    String?
  plan      Plan?    @relation(fields: [planId], references: [id])
  quotaOverride OrganizationQuotaOverride?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  members            OrganizationMember[]
  invites            OrganizationInvite[]
  contacts           Contact[]
  tags               Tag[]
  segments           Segment[]
  templates          MessageTemplate[]
  campaigns          Campaign[]
  schedules          Schedule[]
  messages           Message[]
  automations        Automation[]
  notifications      Notification[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  whatsappAccount    WhatsappAccount?
  conversations      Conversation[]
  notificationSettings NotificationSettings?
  groups             ContactGroup[]
  consentEvents      ContactConsentEvent[]

  @@index([status])
  @@map("organizations")
}

enum Theme {
  LIGHT
  DARK
  AUTO
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SUPPORT
  VIEWER
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  role           Role     @default(VIEWER)
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  emailVerifiedAt DateTime?
  // Platform-level flag, deliberately independent of the org-scoped Role/
  // OrganizationMember system (a user can be SUPER_ADMIN regardless of
  // which role they hold in whichever organization their JWT is currently
  // scoped to, and regardless of org membership at all). There is no API
  // path that sets this — see prisma/scripts/grant-super-admin.ts for the
  // one controlled, manual way to flip it.
  isSuperAdmin   Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  campaigns      Campaign[]      @relation("CampaignCreatedBy")
  schedules      Schedule[]      @relation("ScheduleCreatedBy")
  automations    Automation[]    @relation("AutomationCreatedBy")
  memberships    OrganizationMember[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  assignedConversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("users")
}

/// Single-use, short-lived tokens for the "forgot password" flow. We store
/// a hash of the token (never the raw value) so a leaked database dump
/// can't be used to reset accounts, same pattern as RefreshToken.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Single-use tokens for confirming a user owns the email they signed up
/// with. Not required to log in (we don't want to lock people out of a
/// product they're actively trying), but gates anything that assumes a
/// reachable email address, and is surfaced as a banner until confirmed.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// A user's membership (and role) in a given organization. A user's
/// `organizationId` above is their default/home org (created at signup);
/// this table is what actually governs multi-org access and per-org role,
/// and is what the JWT/RBAC layer checks on every request.
model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role     @default(VIEWER)
  isActive       Boolean  @default(true)
  joinedAt       DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdByIp String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model ApiKey {
  id             String   @id @default(cuid())
  name           String
  keyHash        String   @unique
  lastUsedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  revokedAt      DateTime?

  @@index([organizationId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// WhatsApp Business Account connection (official Cloud API)
// ---------------------------------------------------------------------------

model WhatsappAccount {
  id                    String   @id @default(cuid())
  organizationId        String   @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessAccountId     String
  phoneNumberId         String
  displayPhoneNumber    String
  accessTokenCiphertext String
  webhookVerifyToken    String
  apiVersion            String   @default("v20.0")
  status                String   @default("connected")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([phoneNumberId])
  @@map("whatsapp_accounts")
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  phoneNumber    String
  firstName      String?
  lastName       String?
  email          String?
  company        String?
  city           String?
  customFields   Json     @default("{}")
  notes          String?

  optInStatus    OptInStatus @default(PENDING)
  optInAt        DateTime?
  optOutAt       DateTime?

  isFavorite     Boolean  @default(false)
  isArchived     Boolean  @default(false)

  tags           ContactTag[]
  segments       ContactSegment[]
  groups         ContactGroupMember[]
  messages       Message[]
  campaignRecipients CampaignRecipient[]
  conversations  Conversation[]
  consentEvents  ContactConsentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@map("contacts")
}

enum OptInStatus {
  PENDING
  OPTED_IN
  OPTED_OUT
}

// ---------------------------------------------------------------------------
// Consent history (append-only) — records every opt-in/opt-out transition
// for a contact, independent of the current-state snapshot already kept on
// Contact.optInStatus/optInAt/optOutAt. That snapshot answers "what's the
// contact's status right now"; this answers "prove how it got there and
// when" — the question a compliance review or a support ticket ("why did
// we message/not message this person") actually needs answered, and one
// the snapshot alone can't reconstruct once a second transition overwrites
// optInAt/optOutAt.
// ---------------------------------------------------------------------------

model ContactConsentEvent {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  action         ConsentAction
  source         ConsentSource
  /// Free-text detail: the matched keyword for INBOUND_KEYWORD, an optional
  /// operator-entered note for MANUAL, etc. Never the full inbound message
  /// body — only the specific token that triggered the transition.
  reason         String?
  actorUserId    String?
  metadata       Json     @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, contactId, createdAt])
  @@map("contact_consent_events")
}

enum ConsentAction {
  OPT_IN
  OPT_OUT
}

enum ConsentSource {
  MANUAL
  INBOUND_KEYWORD
  IMPORT
  API
}

model Tag {
  id             String   @id @default(cuid())
  name           String
  color          String   @default("#0A84FF")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       ContactTag[]
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Segment {
  id             String   @id @default(cuid())
  name           String
  description    String?
  rules          Json     @default("{}")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       ContactSegment[]
  createdAt      DateTime @default(now())

  @@map("segments")
}

model ContactSegment {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  segmentId String
  segment   Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([contactId, segmentId])
  @@map("contact_segments")
}

model ContactGroup {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ContactGroupMember[]
  createdAt      DateTime @default(now())

  @@map("contact_groups")
}

model ContactGroupMember {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  groupId   String
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@map("contact_group_members")
}

// ---------------------------------------------------------------------------
// Message templates (WhatsApp-approved + internal drafts)
// ---------------------------------------------------------------------------

model MessageTemplate {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  category         TemplateCategory @default(UTILITY)
  language         String   @default("en_US")
  bodyText         String
  headerType       HeaderType @default(NONE)
  headerContent    String?
  footerText       String?
  buttons          Json     @default("[]")
  variables        Json     @default("[]")

  waTemplateId     String?
  waStatus         WaTemplateStatus @default(DRAFT)
  waRejectionReason String?
  statusHistory    TemplateStatusHistory[]

  schedules        Schedule[]
  campaigns        Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name, language])
  @@index([organizationId])
  @@map("message_templates")
}

model TemplateStatusHistory {
  id         String   @id @default(cuid())
  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  status     WaTemplateStatus
  note       String?
  changedAt  DateTime @default(now())

  @@index([templateId, changedAt])
  @@map("template_status_history")
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum HeaderType {
  NONE
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum WaTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

// ---------------------------------------------------------------------------
// Messages (individual send/receive log)
// ---------------------------------------------------------------------------

model Message {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  direction      MessageDirection
  type           MessageType
  content        Json
  status         MessageStatus @default(QUEUED)
  waMessageId    String?
  providerTimestamp DateTime?
  errorCode      String?
  errorMessage   String?
  retryCount     Int      @default(0)

  campaignId     String?
  campaign       Campaign? @relation(fields: [campaignId], references: [id])
  scheduleId     String?
  schedule       Schedule? @relation(fields: [scheduleId], references: [id])

  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, waMessageId])
  @@index([organizationId, status])
  @@index([contactId])
  @@index([campaignId])
  @@index([conversationId, createdAt])
  // Supports QuotaService's monthly-message-usage count (organizationId +
  // direction + date range) without a full scan of the org's message
  // history — see quota.service.ts.
  @@index([organizationId, direction, createdAt])
  @@map("messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT_CARD
  INTERACTIVE_BUTTONS
  INTERACTIVE_LIST
  TEMPLATE
  UNKNOWN
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// ---------------------------------------------------------------------------
// Conversations (Phase D — durable, tenant-isolated thread per contact)
// ---------------------------------------------------------------------------

/// One conversation per (organization, contact). The current architecture
/// has exactly one WhatsApp account/phone number per organization
/// (WhatsappAccount.organizationId is @unique — see Phase I in
/// PRODUCTION_UPGRADE_PLAN.md for the planned multi-account upgrade), so
/// organization+contact alone is enough to uniquely identify a channel
/// today; this intentionally doesn't try to anticipate multi-account
/// scoping ahead of that phase actually landing.
model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  status         ConversationStatus @default(OPEN)
  assignedUserId String?
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  unreadCount    Int       @default(0)
  lastMessageAt  DateTime?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  metadata       Json      @default("{}")

  messages       Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, contactId])
  @@index([organizationId, status, lastMessageAt])
  @@index([organizationId, assignedUserId])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Schedules (recurring / random-time / random-message sender)
// ---------------------------------------------------------------------------

model Schedule {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation("ScheduleCreatedBy", fields: [createdById], references: [id])

  name           String
  status         ScheduleStatus @default(ACTIVE)

  recurrenceType RecurrenceType
  cronExpression String?
  intervalHours  Int?
  intervalDays   Int?
  daysOfWeek     Int[]    @default([])
  timeOfDay      String?
  timezone       String   @default("UTC")

  randomTimeEnabled Boolean @default(false)
  randomWindowStart String?
  randomWindowEnd   String?
  randomMinGapMinutes Int?
  randomMaxGapMinutes Int?
  avoidSameTimeAsLast Boolean @default(true)

  messagePool    Json     @default("[]")
  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])

  audienceType   AudienceType @default(SEGMENT)
  audienceRef    Json     @default("{}")

  startDate      DateTime?
  expiryDate     DateTime?
  nextRunAt      DateTime?
  lastRunAt      DateTime?

  messages       Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("schedules")
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  DISABLED
  EXPIRED
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  EVERY_X_HOURS
  EVERY_X_DAYS
  BUSINESS_DAYS
  WEEKENDS
  SPECIFIC_DATES
  CUSTOM_CRON
}

enum AudienceType {
  ALL_CONTACTS
  SEGMENT
  GROUP
  TAG
  CUSTOM_LIST
}

// ---------------------------------------------------------------------------
// Campaigns
// ---------------------------------------------------------------------------

model Campaign {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  name           String
  type           CampaignType @default(CUSTOM)
  status         CampaignStatus @default(DRAFT)

  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])

  audienceType   AudienceType @default(SEGMENT)
  audienceRef    Json     @default("{}")

  scheduledAt    DateTime?
  launchedAt     DateTime?
  completedAt    DateTime?

  stats          Json     @default("{\"sent\":0,\"delivered\":0,\"read\":0,\"failed\":0}")

  recipients     CampaignRecipient[]
  messages       Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("campaigns")
}

enum CampaignType {
  WELCOME
  REMINDER
  PROMOTION
  NEWSLETTER
  FESTIVAL_GREETING
  FOLLOW_UP
  CUSTOM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     MessageStatus @default(QUEUED)
  createdAt  DateTime @default(now())

  @@unique([campaignId, contactId])
  @@map("campaign_recipients")
}

// ---------------------------------------------------------------------------
// Visual automation builder
// ---------------------------------------------------------------------------

model Automation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User     @relation("AutomationCreatedBy", fields: [createdById], references: [id])

  name           String
  description    String?
  status         AutomationStatus @default(DRAFT)
  graph          Json     // nodes + edges for the drag & drop canvas
  triggerType    AutomationTriggerType

  runsCount      Int      @default(0)
  lastRunAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("automations")
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum AutomationTriggerType {
  KEYWORD_RECEIVED
  CONTACT_CREATED
  TAG_ADDED
  CAMPAIGN_COMPLETED
  WEBHOOK
  SCHEDULE
  MANUAL
}

// ---------------------------------------------------------------------------
// Notification channel delivery settings
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Limits & Quotas
// ---------------------------------------------------------------------------

/// A resource limit of `null` means unlimited for that resource — used both
/// here (a plan tier that doesn't cap a given resource) and on
/// OrganizationQuotaOverride (meaning "no override, fall back to the plan").
/// The effective limit for an organization is always:
///   quotaOverride.<field> ?? plan?.<field> ?? null (unlimited)
/// computed in QuotaService, never duplicated into the Organization row
/// itself — this table is the one place plan limits are defined so five
/// tiers don't mean five copies of the same numbers pasted around the app.
///
/// Seeded with FREE/STARTER/PRO/BUSINESS/CUSTOM (see the super_admin_quotas
/// migration) so the next phase (Plans management UI) has real rows to
/// manage rather than needing its own migration first — but nothing in this
/// phase assigns organizations to a plan automatically; Organization.planId
/// stays null until a Super Admin explicitly sets it.
model Plan {
  id   String @id @default(cuid())
  key  String @unique
  name String

  maxUsers                        Int?
  maxContacts                     Int?
  maxWhatsappAccounts              Int?
  maxMessagesPerMonth              Int?
  maxAutomations                   Int?
  maxAutomationExecutionsPerMonth  Int?
  maxApiRequestsPerMonth           Int?
  maxStorageMb                     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]

  @@map("plans")
}

/// Per-organization override of specific resource limits, set only by a
/// Super Admin (see super-admin/quotas.*). One row per organization at
/// most (organizationId is unique). For each field: `null` means "no
/// override, defer to the plan's value"; `-1` means "explicitly unlimited
/// for this org regardless of plan"; any other value is the override limit
/// itself. See QuotaService.resolveEffectiveLimit for the single place this
/// convention is interpreted.
model OrganizationQuotaOverride {
  id             String   @id @default(cuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  maxUsers                        Int?
  maxContacts                     Int?
  maxWhatsappAccounts              Int?
  maxMessagesPerMonth              Int?
  maxAutomations                   Int?
  maxAutomationExecutionsPerMonth  Int?
  maxApiRequestsPerMonth           Int?
  maxStorageMb                     Int?

  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("organization_quota_overrides")
}

model NotificationSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  emailEnabled       Boolean @default(false)
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPasswordCiphertext String?
  smtpFromAddress    String?
  notifyEmailTo      String?

  slackEnabled       Boolean @default(false)
  slackWebhookUrl    String?

  telegramEnabled    Boolean @default(false)
  telegramBotTokenCiphertext String?
  telegramChatId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// Automation run history
// ---------------------------------------------------------------------------

model OrganizationInvite {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  token          String   @unique
  invitedByUserId String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("organization_invites")
}

model AutomationRun {
  id             String   @id @default(cuid())
  automationId   String
  organizationId String
  contactId      String

  status         AutomationRunStatus @default(RUNNING)
  steps          Json     @default("[]")
  errorMessage   String?

  // --- Wait-for-reply state -------------------------------------------
  // Populated only while status = WAITING_FOR_REPLY, and left in place
  // afterwards as a record of how the run got resumed (or timed out).
  // conversationId is the match key an inbound message is looked up by —
  // stored directly rather than re-derived from contactId each time,
  // since it's what InboundMessageService's event already carries.
  conversationId     String?
  waitingNodeId      String?
  waitingSince       DateTime?
  waitExpiresAt      DateTime?
  // BullMQ job id for the scheduled timeout continuation, so a reply that
  // arrives first can cancel it — without this, a stale timeout job would
  // still fire later and attempt a second (blocked, but wasted) continuation.
  waitTimeoutJobId   String?
  // The inbound Message.id that resumed this run, if resumed by a reply
  // rather than by timing out. Distinct from steps (a full log) — this is
  // the one fact "was this specific message already used to resume a run"
  // that duplicate-delivery handling needs to check quickly.
  resumedByMessageId String?
  // context.variables at the moment execution paused — the only place this
  // needs to be durably persisted, since (unlike the plain `delay` node) a
  // reply-triggered continuation isn't handed its context via a BullMQ job
  // payload the way the timeout continuation is.
  contextVariables   Json      @default("{}")

  startedAt DateTime @default(now())
  completedAt DateTime?

  @@index([automationId, startedAt])
  @@index([organizationId, conversationId, status])
  // Supports QuotaService's monthly-automation-execution-usage count.
  @@index([organizationId, startedAt])
  @@map("automation_runs")
}

enum AutomationRunStatus {
  RUNNING
  WAITING_FOR_REPLY
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Webhook idempotency (Phase B — WhatsApp webhook hardening)
// ---------------------------------------------------------------------------

/// Records each inbound provider webhook sub-event exactly once so a
/// duplicate delivery (Meta explicitly documents that the same event can be
/// delivered more than once) is detected and skipped instead of reprocessed.
/// One WhatsApp POST can bundle several independent sub-events (status
/// updates, inbound messages, template updates), so idempotency is tracked
/// per sub-event rather than per HTTP request.
model WebhookEvent {
  id              String             @id @default(cuid())
  provider        String             @default("whatsapp")
  externalEventId String
  eventType       String
  payload         Json
  status          WebhookEventStatus @default(RECEIVED)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  error           String?
  retryCount      Int                @default(0)

  @@unique([provider, externalEventId])
  @@index([provider, status])
  @@map("webhook_events")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  channel        NotificationChannel
  title          String
  body           String
  isRead         Boolean  @default(false)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, userId])
  @@map("notifications")
}

enum NotificationChannel {
  DESKTOP
  EMAIL
  IN_APP
  WEBHOOK
  SLACK
  TELEGRAM
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  action         String
  entityType     String
  entityId       String?
  device         String?
  ipAddress      String?
  status         String   @default("success")
  metadata       Json     @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
