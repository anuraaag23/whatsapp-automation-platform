# Dependencies
node_modules/
**/node_modules/

# Environment files — these contain real passwords/secrets and must NEVER
# be committed. Render/Vercel get their env vars typed into their own
# dashboards instead, not from a file in the repo.
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Exception: packages/backend/prisma/.env is a dedicated, checked-in file.
# It is read automatically by the Prisma CLI (migrate/generate/studio) —
# never by the running app — and contains ONLY the fixed, deterministic
# local docker-compose test-database connection string used to apply
# migrations before e2e tests run (see TEST_DATABASE_REPORT.md). No real
# credentials, secrets, or production URLs belong in this file, ever — if
# that ever stops being true, remove this exception immediately.
!packages/backend/prisma/.env

# Build output
dist/
.next/
out/
build/

# Prisma
**/node_modules/.prisma

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Docker volumes data (if ever created locally outside Docker's own volume mgmt)
postgres_data/
redis_data/
